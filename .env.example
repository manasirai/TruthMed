# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...your-key-here...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Database
DATABASE_URL=sqlite:///./truthmed.db
# For PostgreSQL: postgresql://user:password@localhost:5432/truthmed

# Application
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Rate limiting
RATE_LIMIT_PER_MINUTE=10
REQUEST_MAX_CHARS=2000

# Optional: Brave Search API for evidence retrieval
# BRAVE_SEARCH_API_KEY=your-brave-api-key-here


